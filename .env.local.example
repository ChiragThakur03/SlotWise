# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — Developers > API keys
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs for the 3 subscription plans (Developers > Product catalog)
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_STUDIO=

# Resend — email reminders/confirmations
RESEND_API_KEY=
RESEND_FROM_EMAIL=bookings@slotwise.io

# Twilio — SMS reminders/confirmations
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Public app URL, used in emails/SMS for booking links + calendar invites
NEXT_PUBLIC_APP_URL=http://localhost:3000
